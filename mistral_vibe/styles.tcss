/* ═══════════════════════════════════════════════════
   Mistral Vibe — Codex-style dark theme
   ═══════════════════════════════════════════════════ */

/* ── Global ── */
Screen {
    background: #0d1117;
    color: #e6edf3;
}

/* ── Chat Scroll Area ── */
#chat-scroll {
    height: 1fr;
    background: #0d1117;
    scrollbar-background: #0d1117;
    scrollbar-color: #30363d;
    scrollbar-color-hover: #58a6ff;
    scrollbar-gutter: stable;
}

#chat-messages {
    layout: vertical;
    padding: 1 2;
    min-height: 100%;
}

/* ── User Turn ── */
UserTurn {
    background: #161b22;
    border-left: thick #58a6ff;
    padding: 0 1;
    margin-bottom: 1;
}

UserTurn .user-label {
    color: #58a6ff;
    text-style: bold;
    padding-bottom: 0;
}

UserTurn .user-content {
    color: #e6edf3;
    padding-top: 0;
}

/* ── Assistant Turn ── */
AssistantTurn {
    padding: 0 1;
    margin-bottom: 1;
}

AssistantTurn .assistant-label {
    color: #bb86fc;
    text-style: bold;
}

AssistantTurn LoadingIndicator {
    background: transparent;
    color: #bb86fc;
    height: 1;
}

AssistantTurn Markdown {
    background: #0d1117;
    color: #e6edf3;
    margin: 0;
    padding: 0;
    link-background: transparent;
    link-color: #58a6ff;
    link-style: underline;
}

/* Markdown code blocks */
AssistantTurn Markdown MarkdownFence {
    background: #161b22;
    border: solid #30363d;
    padding: 0 1;
    margin: 0 0 0 0;
}

/* ── Welcome Banner ── */
WelcomeBanner {
    padding: 2 2;
    color: #8b949e;
    text-align: center;
    margin-bottom: 1;
}

/* ── Help Overlay ── */
HelpOverlay {
    background: #161b22;
    border: round #30363d;
    padding: 1 2;
    margin: 1 4;
    color: #e6edf3;
}

/* ── Input Row ── */
#input-row {
    height: auto;
    min-height: 3;
    background: #0d1117;
    border-top: tall #30363d;
    padding: 0 1;
    align: left middle;
}

#prompt-icon {
    color: #58a6ff;
    text-style: bold;
    width: auto;
    padding: 0 1;
    margin-top: 1;
}

#message-input {
    background: #0d1117;
    color: #e6edf3;
    border: none;
    padding: 1 0;
    height: auto;
    width: 1fr;
}

#message-input:focus {
    border: none;
    outline: none;
}

#message-input:disabled {
    color: #8b949e;
}

/* ── Footer ── */
Footer {
    background: #161b22;
    border-top: tall #30363d;
    color: #8b949e;
}

Footer > .footer--key {
    background: #30363d;
    color: #e6edf3;
}

/* ── Header Bar ── */
HeaderBar {
    height: 3;
    background: #161b22;
    border-bottom: tall #30363d;
    padding: 0 2;
    align: left middle;
}

HeaderBar .header-logo {
    color: #58a6ff;
    text-style: bold;
    width: auto;
}

HeaderBar .header-sep {
    color: #30363d;
    width: auto;
    margin: 0 1;
}

HeaderBar .header-model {
    color: #bb86fc;
    width: auto;
}

HeaderBar .header-dir {
    color: #3fb950;
    width: auto;
    margin-left: 2;
}

HeaderBar .header-status {
    color: #8b949e;
    width: 1fr;
    text-align: right;
}

/* ── Toast Notifications ── */
Toast {
    background: #161b22;
    border: solid #30363d;
    color: #e6edf3;
}
