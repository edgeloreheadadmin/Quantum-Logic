/* ══════════════════════════════════════════════════════════
   Mistral Vibe — GitHub-dark Codex theme
   Multi-tab layout with virtual hardware dashboards
   ══════════════════════════════════════════════════════════ */

/* ── Global ─────────────────────────────────────────────── */
Screen {
    background: #0d1117;
    color: #e6edf3;
}

/* ── Header bar ─────────────────────────────────────────── */
HeaderBar {
    height: 3;
    background: #161b22;
    border-bottom: tall #21262d;
    padding: 0 2;
    align: left middle;
}

#hl-logo {
    color: #58a6ff;
    text-style: bold;
    width: auto;
}

.h-sep {
    color: #30363d;
    width: auto;
    margin: 0 1;
}

#hl-model {
    color: #bc8cff;
    width: auto;
}

#hl-dir {
    color: #3fb950;
    width: auto;
    margin-left: 2;
}

#hl-status {
    color: #8b949e;
    width: 1fr;
    text-align: right;
}

/* ── Tabs ────────────────────────────────────────────────── */
TabbedContent {
    height: 1fr;
    background: #0d1117;
}

TabbedContent ContentSwitcher {
    background: #0d1117;
    height: 1fr;
}

Tabs {
    background: #161b22;
    border-bottom: tall #21262d;
    padding: 0 1;
}

Tab {
    color: #8b949e;
    padding: 0 2;
    background: #161b22;
}

Tab:hover {
    color: #e6edf3;
    background: #21262d;
}

Tab.-active {
    color: #58a6ff;
    background: #0d1117;
    text-style: bold;
    border-top: tall #58a6ff;
}

TabPane {
    background: #0d1117;
    height: 1fr;
    padding: 0;
}

/* ── Chat tab ────────────────────────────────────────────── */
#chat-scroll {
    height: 1fr;
    background: #0d1117;
    scrollbar-background: #0d1117;
    scrollbar-color: #30363d;
    scrollbar-color-hover: #58a6ff;
}

#chat-messages {
    layout: vertical;
    padding: 1 2;
    min-height: 100%;
}

UserTurn {
    background: #161b22;
    border-left: thick #58a6ff;
    padding: 0 1;
    margin-bottom: 1;
}

AssistantTurn {
    padding: 0 1;
    margin-bottom: 1;
}

.turn-label {
    text-style: bold;
    padding-bottom: 0;
}

UserTurn .turn-label {
    color: #58a6ff;
}

AssistantTurn .turn-label {
    color: #bc8cff;
}

.turn-content {
    color: #e6edf3;
}

AssistantTurn LoadingIndicator {
    background: transparent;
    color: #bc8cff;
    height: 1;
}

AssistantTurn Markdown {
    background: #0d1117;
    color: #e6edf3;
    margin: 0;
    padding: 0;
    link-color: #58a6ff;
}

AssistantTurn Markdown MarkdownFence {
    background: #161b22;
    border: solid #30363d;
    padding: 0 1;
}

WelcomeBanner {
    padding: 2 2;
    color: #8b949e;
    text-align: center;
    margin-bottom: 1;
}

#input-row {
    height: auto;
    min-height: 3;
    background: #0d1117;
    border-top: tall #21262d;
    padding: 0 1;
    align: left middle;
}

#prompt-icon {
    color: #58a6ff;
    text-style: bold;
    width: auto;
    padding: 0 1;
    margin-top: 1;
}

#message-input {
    background: #0d1117;
    color: #e6edf3;
    border: none;
    padding: 1 0;
    height: auto;
    width: 1fr;
}

#message-input:focus {
    border: none;
    outline: none;
}

#message-input:disabled {
    color: #8b949e;
}

/* ── Dashboard panels (NPU / Neural / Evo / Mem / Cog) ─── */
#npu-scroll,
#nn-scroll,
#evo-scroll,
#mem-scroll,
#cog-scroll {
    height: 1fr;
    background: #0d1117;
    scrollbar-background: #0d1117;
    scrollbar-color: #30363d;
    scrollbar-color-hover: #58a6ff;
    padding: 1 2;
}

NPUPanel,
NeuralPanel,
EvolutionPanel,
MemoryPanel,
CognitivePanel {
    background: #0d1117;
    color: #e6edf3;
    padding: 0;
    height: auto;
}

/* ── Footer ──────────────────────────────────────────────── */
Footer {
    background: #161b22;
    border-top: tall #21262d;
    color: #8b949e;
}

Footer > .footer--key {
    background: #21262d;
    color: #e6edf3;
}

/* ── Toast notifications ─────────────────────────────────── */
Toast {
    background: #161b22;
    border: solid #30363d;
    color: #e6edf3;
}
